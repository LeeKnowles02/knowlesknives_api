PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_NAME=knowles_knives
DB_USER=root
DB_PASSWORD=password
JWT_SECRET=replace_this_with_a_real_secret
JWT_EXPIRES_IN=1d
CLIENT_URL=http://localhost:4200
NODE_ENV=development

# Optional — used by npm run seed:admin (defaults shown)
# ADMIN_EMAIL=admin@knowlesknives.co.za
# ADMIN_PASSWORD=Admin123!

# Optional — Cloudinary image uploads (recommended for production)
# Copy from: https://console.cloudinary.com → Dashboard → API environment variable
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
